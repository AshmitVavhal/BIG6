# Hugging Face Authentication Token
HF_TOKEN=your_huggingface_token_here

# Google Gemini API Key (Backend only, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Hardware Configuration
DEVICE=cuda
MAX_VRAM_GB=5.5
FORCE_CPU_FALLBACK=false

# Remote-Sensing VLM (GeoChat)
GEOCHAT_MODEL_PATH=MBZUAI/geochat-7B
GEOCHAT_LOAD_IN_4BIT=true
GEOCHAT_LOAD_IN_8BIT=false
GEOCHAT_LORA_PATH=outputs/satquery-geochat-lora
GEOCHAT_USE_LORA=false

# Specialized Remote-Sensing Computer Vision Models
LAE_DINO_MODEL_PATH=jaychempan/LAE-DINO
MASK2FORMER_MODEL_PATH=facebook/mask2former-swin-tiny-cityscapes-semantic
CHANGEMAMBA_MODEL_PATH=models/changemamba
CHANGE_THRESHOLD=0.5
